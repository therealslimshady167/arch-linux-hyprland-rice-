#!/bin/bash

# Start the real CAVA using the normal config
/usr/bin/cava &
CAVA_PID=$!

# Clean up CAVA when the visualizer exits
cleanup() {
    kill "$CAVA_PID" 2>/dev/null
    wait "$CAVA_PID" 2>/dev/null
}

trap cleanup EXIT INT TERM

# Start the custom braille visualizer
~/.local/bin/cava-braille
