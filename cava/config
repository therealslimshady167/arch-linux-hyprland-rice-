[general]
framerate = 64
bars = 64

[input]
method = pulse
source = alsa_output.pci-0000_00_1f.3-platform-skl_hda_dsp_generic.HiFi__Speaker__sink.monitor
[output]
method = raw
raw_target = /tmp/cava.raw
data_format = ascii

[color]
background = default
foreground = default

[smoothing]
monstercat = 0
waves = 0

